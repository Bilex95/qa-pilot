# QA Pilot environment. Copy to .env and fill the empty values. Never commit .env.
# Secrets are empty on purpose.

APP_ENV=development
LOG_LEVEL=INFO

# Database (docker compose builds DATABASE_URL from these)
POSTGRES_USER=qapilot
POSTGRES_PASSWORD=
POSTGRES_DB=qapilot
DB_HOST_PORT=5433

# Auth (D-010). JWT_SECRET: at least 32 random bytes, for example: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
INVITATION_DAYS=7

# Web
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Attachments (D-009)
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=10

# AI (AI_SPEC). mock works offline. AI_PROVIDER=mock|anthropic|gemini|openai_compatible; each real one needs its key.
AI_PROVIDER=mock
# Optional second provider used when the first one is down or fails: anthropic, gemini or openai_compatible. Empty means none.
# Recommended free live setup: AI_PROVIDER=gemini and AI_FALLBACK_PROVIDER=openai_compatible, with both keys set below.
# Groq free tier (measured 27 Nov 2026): 8,000 tokens per minute and 1,000 requests per day per model. A 429 is retried once.
AI_FALLBACK_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Google AI Studio free tier. An empty model means gemini-3.5-flash-lite. A retired model returns 404, so check Google's model list.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=
# Any OpenAI compatible endpoint. The values below are Groq. OpenRouter (https://openrouter.ai/api/v1) also works, for example
# google/gemma-4-31b-it:free (not tested here, its free list changes often).
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=openai/gpt-oss-20b
AI_USER_RATE_PER_MINUTE=20
AI_ORG_DAILY_LIMIT_DEFAULT=500

# Seed CLI (local and test only, D-041). Password shared by every seeded persona.
SEED_USER_PASSWORD=
