# QA Pilot environment. Copy to .env and fill the empty values. Never commit .env.
# Secrets are empty on purpose.

APP_ENV=development
LOG_LEVEL=INFO

# Database (docker compose builds DATABASE_URL from these)
POSTGRES_USER=qapilot
POSTGRES_PASSWORD=
POSTGRES_DB=qapilot
DB_HOST_PORT=5433

# Auth (D-010). JWT_SECRET: at least 32 random bytes, for example: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
INVITATION_DAYS=7

# Web
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Attachments (D-009)
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=10

# AI (AI_SPEC). mock works offline. AI_PROVIDER=mock|anthropic|gemini|openai_compatible; each real one needs its key.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Google AI Studio free tier. Leave the model and base URL empty to use the defaults.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=
# Any OpenAI compatible endpoint, for example Groq (https://api.groq.com/openai/v1) or OpenRouter (https://openrouter.ai/api/v1).
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
AI_USER_RATE_PER_MINUTE=20
AI_ORG_DAILY_LIMIT_DEFAULT=500

# Seed CLI (local and test only, D-041). Password shared by every seeded persona.
SEED_USER_PASSWORD=
