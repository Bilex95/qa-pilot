{
  "name": "qa-pilot-frontend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:docker": "next dev --webpack --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "api:types": "openapi-typescript openapi.json -o src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.108.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.4.6",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
